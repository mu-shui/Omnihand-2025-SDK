# OmniHand 2025 SDK - USB Device Permission Rules
# Generated on Wed Mar 25 01:48:55 PM CST 2026

# Generic rules for USB serial devices
KERNEL=="ttyACM[0-9]*", MODE="0666", GROUP="dialout"
KERNEL=="ttyUSB[0-9]*", MODE="0666", GROUP="dialout"

# Detected devices (with USB port):
# ZLG USBCANFD at port 3-7
KERNEL=="3-7", SUBSYSTEM=="usb", ATTRS{idVendor}=="3068", ATTRS{idProduct}=="0009", MODE="0666"


